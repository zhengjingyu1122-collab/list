<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>出國行李清單</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang TC", "Microsoft JhengHei", sans-serif;
    background: #fff8ee;
    color: #3d3226;
    margin: 0;
    padding: 32px 28px 80px;
    background-image:
      repeating-linear-gradient(45deg, #ff6f4d 0, #ff6f4d 10px, #fff8ee 10px, #fff8ee 20px);
    background-repeat: repeat-y;
    background-size: 26px 100%;
    background-position-x: 0, 100%;
  }
  .wrap {
    max-width: 640px; margin: 0 auto;
    background: #ffffff;
    border: 2px solid #ffe0b2;
    border-radius: 16px;
    padding: 32px 32px 24px;
  }
  h1 {
    font-size: 30px; font-weight: 800; margin: 0 0 24px; text-align: center;
    letter-spacing: 1px;
    background: linear-gradient(120deg, #ff6f4d 0%, #ff9d3d 50%, #ffc93c 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    text-transform: uppercase;
  }
  .progress-row {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 6px; font-size: 13px; color: #8a7a63;
  }
  .progress-bar-bg {
    height: 10px; background: #ffe9d1; border-radius: 8px; overflow: hidden; margin-bottom: 24px;
  }
  .progress-bar-fill {
    height: 100%; width: 0%; background: linear-gradient(90deg, #ff6f4d, #ffc93c); transition: width .2s;
  }
  .category { margin-bottom: 22px; }
  .cat-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .cat-title {
    display: inline-block; font-size: 14px; font-weight: 700; color: #fff;
    background: #17a398; padding: 6px 16px; border-radius: 16px;
  }
  .cat-delete { cursor: pointer; color: #c9b8a3; font-size: 13px; border: none; background: none; padding: 4px; }
  .cat-delete:hover { color: #e0483e; }
  .items-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px;
  }
  .item-row {
    position: relative;
    display: flex; align-items: center; gap: 8px; padding: 9px 10px;
    border: 2px solid #ffe0b2; border-radius: 10px; font-size: 14px; cursor: pointer;
    background: #fffdf8; user-select: none;
  }
  .item-row.checked { background: #e5f8f4; border-color: #17a398; }
  .checkbox {
    width: 19px; height: 19px; flex-shrink: 0; border: 2px solid #ffb066; border-radius: 5px;
    display: flex; align-items: center; justify-content: center; background: #fff;
  }
  .item-row.checked .checkbox { background: #17a398; border-color: #17a398; }
  .checkbox svg { width: 12px; height: 12px; display: none; }
  .item-row.checked .checkbox svg { display: block; }
  .item-label { flex: 1; }
  .item-row.checked .item-label { text-decoration: line-through; color: #6ba89e; }
  .item-remove {
    position: absolute; top: -7px; right: -7px;
    width: 18px; height: 18px; border-radius: 50%;
    font-size: 12px; line-height: 1; color: #fff; background: #e0483e;
    border: 2px solid #fffdf8; cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .item-remove:hover { background: #c73a30; }
  .item-edit-input {
    flex: 1; font-size: 14px; padding: 2px 4px; border: 1.5px solid #17a398; border-radius: 5px; min-width: 0;
  }
  .add-row { display: flex; gap: 6px; margin-top: 10px; }
  .add-row input {
    flex: 1; font-size: 13px; padding: 8px 10px; border: 2px solid #ffe0b2; border-radius: 8px;
  }
  .add-row button {
    padding: 0 14px; border: 2px solid #ffe0b2; border-radius: 8px; background: #fff; cursor: pointer; font-size: 16px; color: #ff6f4d; font-weight: 700;
  }
  .add-row button:hover { background: #fff1e0; }
  .error-text { font-size: 12px; color: #e0483e; margin-top: 4px; display: none; }
  .new-cat-box {
    border: 2px dashed #ffb066; border-radius: 14px; padding: 14px 16px; margin-top: 8px;
  }
  .new-cat-box .cat-title { background: none; color: #ff6f4d; padding: 0; border-radius: 0; margin-bottom: 10px; }
  .footer-row { display: flex; gap: 10px; margin-top: 24px; }
  .reset-btn {
    flex: 1; padding: 12px; border: 2px solid #ffe0b2; border-radius: 10px; background: #fff;
    cursor: pointer; font-size: 14px; font-weight: 600; color: #ff6f4d;
  }
  .reset-btn:hover { background: #fff1e0; }
</style>
</head>
<body>
<div class="wrap">
  <h1>What's in my luggage</h1>
  <div class="progress-row">
    <span>已完成</span>
    <span id="progress-text">0 / 0</span>
  </div>
  <div class="progress-bar-bg"><div class="progress-bar-fill" id="progress-bar"></div></div>

  <div id="categories"></div>

  <div class="new-cat-box">
    <div class="cat-title">新增分類</div>
    <div class="add-row">
      <input type="text" id="new-cat-input" placeholder="輸入分類名稱">
      <button id="new-cat-btn">＋</button>
    </div>
    <div class="error-text" id="new-cat-error"></div>
  </div>

  <div class="footer-row">
    <button class="reset-btn" id="reset-btn">全部清空</button>
  </div>
</div>

<script>
const DEFAULT_DATA = [
  {cat:"文件類", items:["護照","簽證","2吋照片","電子機票","台幣","外幣","信用卡","旅遊保險","身份證件","飯店預訂單","網路","國際駕照","家鑰匙"]},
  {cat:"日用品類 · 換洗衣物", items:["內衣褲","衣服","褲子","外套","襪子"]},
  {cat:"日用品類 · 盥洗用具", items:["牙膏","牙刷","洗髮精","沐浴乳","浴帽","化妝棉","棉花棒","毛巾","髮束","梳子"]},
  {cat:"日用品類 · 隱眼眼鏡", items:["隱形眼鏡","隱眼盒子","藥水","眼鏡"]},
  {cat:"日用品類 · 搭機必備", items:["眼罩","耳塞"]},
  {cat:"日用品類 · 化妝護膚品", items:["卸妝油","洗面乳","保溼乳","液防曬","面膜","護髮","化妝品","護唇膏","體香劑"]},
  {cat:"日用品類 · 炎熱國度", items:["泳衣","泳褲","泳帽","蛙鏡","海灘用涼鞋","太陽眼鏡","帽子"]},
  {cat:"日用品類 · 寒冷國度", items:["風衣","雪衣","雪帽","耳罩","暖暖包","保暖用品"]},
  {cat:"藥品類", items:["暈車藥","止瀉藥","OK繃","感冒藥","常備藥","腸胃藥"]},
  {cat:"電器類", items:["轉換插頭","充電線","吹風機","相機"]}
];
const DEFAULT_CAT_NAMES = DEFAULT_DATA.map(g => g.cat);

const STATE_KEY = "luggage_checklist_state";
const CUSTOM_KEY = "luggage_checklist_custom_items";
const CUSTOM_CAT_KEY = "luggage_checklist_custom_cats";
const OVERRIDE_KEY = "luggage_checklist_item_overrides";
const REMOVED_KEY = "luggage_checklist_removed_defaults";

let state = JSON.parse(localStorage.getItem(STATE_KEY) || "{}");
let customItems = JSON.parse(localStorage.getItem(CUSTOM_KEY) || "{}");
let customCategories = JSON.parse(localStorage.getItem(CUSTOM_CAT_KEY) || "[]");
let itemOverrides = JSON.parse(localStorage.getItem(OVERRIDE_KEY) || "{}");
let removedDefaults = JSON.parse(localStorage.getItem(REMOVED_KEY) || "[]");

function saveState() { localStorage.setItem(STATE_KEY, JSON.stringify(state)); }
function saveCustom() { localStorage.setItem(CUSTOM_KEY, JSON.stringify(customItems)); }
function saveCustomCats() { localStorage.setItem(CUSTOM_CAT_KEY, JSON.stringify(customCategories)); }
function saveOverrides() { localStorage.setItem(OVERRIDE_KEY, JSON.stringify(itemOverrides)); }
function saveRemoved() { localStorage.setItem(REMOVED_KEY, JSON.stringify(removedDefaults)); }

function displayName(key, item) {
  return itemOverrides[key] || item;
}

function allCategories() {
  const base = DEFAULT_DATA.map(g => ({
    cat: g.cat,
    items: [...g.items.filter(i => !removedDefaults.includes(g.cat + "::" + i)), ...(customItems[g.cat] || [])],
    isCustomCat: false
  }));
  const extra = customCategories.map(cat => ({ cat, items: [...(customItems[cat] || [])], isCustomCat: true }));
  return [...base, ...extra];
}

function allItemKeys() {
  return allCategories().flatMap(g => g.items.map(i => g.cat + "::" + i));
}

function updateProgress() {
  const keys = allItemKeys();
  const checked = keys.filter(k => state[k]).length;
  document.getElementById("progress-text").textContent = checked + " / " + keys.length;
  document.getElementById("progress-bar").style.width = (keys.length ? (checked / keys.length * 100) : 0) + "%";
}

function checkSvg() {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
}

function render() {
  const container = document.getElementById("categories");
  container.innerHTML = "";

  allCategories().forEach(group => {
    const section = document.createElement("div");
    section.className = "category";

    const titleRow = document.createElement("div");
    titleRow.className = "cat-title-row";
    const title = document.createElement("div");
    title.className = "cat-title";
    title.textContent = group.cat;
    titleRow.appendChild(title);

    if (group.isCustomCat) {
      const delBtn = document.createElement("button");
      delBtn.className = "cat-delete";
      delBtn.textContent = "刪除分類";
      delBtn.addEventListener("click", () => {
        customCategories = customCategories.filter(c => c !== group.cat);
        delete customItems[group.cat];
        Object.keys(state).forEach(k => { if (k.startsWith(group.cat + "::")) delete state[k]; });
        Object.keys(itemOverrides).forEach(k => { if (k.startsWith(group.cat + "::")) delete itemOverrides[k]; });
        saveCustomCats(); saveCustom(); saveState(); saveOverrides();
        render(); updateProgress();
      });
      titleRow.appendChild(delBtn);
    }
    section.appendChild(titleRow);

    if (group.items.length > 0) {
      const grid = document.createElement("div");
      grid.className = "items-grid";
      group.items.forEach(item => {
        const key = group.cat + "::" + item;
        const checked = !!state[key];
        const isCustomItem = (customItems[group.cat] || []).includes(item);

        const row = document.createElement("div");
        row.className = "item-row" + (checked ? " checked" : "");
        row.setAttribute("role", "checkbox");
        row.setAttribute("aria-checked", String(checked));
        row.setAttribute("tabindex", "0");

        const box = document.createElement("span");
        box.className = "checkbox";
        box.innerHTML = checkSvg();
        row.appendChild(box);

        const label = document.createElement("span");
        label.className = "item-label";
        label.textContent = displayName(key, item);
        row.appendChild(label);

        function toggle() {
          state[key] = !state[key];
          saveState();
          render();
          updateProgress();
        }

        let clickTimer = null;
        row.addEventListener("click", (e) => {
          if (e.target.closest(".item-remove")) return;
          if (clickTimer) {
            clearTimeout(clickTimer);
            clickTimer = null;
            return;
          }
          clickTimer = setTimeout(() => {
            clickTimer = null;
            toggle();
          }, 220);
        });
        row.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); }
        });

        function startEdit(e) {
          e.stopPropagation();
          if (clickTimer) { clearTimeout(clickTimer); clickTimer = null; }
          const input = document.createElement("input");
          input.type = "text";
          input.className = "item-edit-input";
          input.value = displayName(key, item);
          row.replaceChild(input, label);
          input.focus();
          input.select();

          function finishEdit() {
            const val = input.value.trim();
            if (val && val !== item) {
              itemOverrides[key] = val;
            } else {
              delete itemOverrides[key];
            }
            saveOverrides();
            render();
            updateProgress();
          }
          input.addEventListener("blur", finishEdit);
          input.addEventListener("keydown", (ev) => {
            if (ev.key === "Enter") { ev.preventDefault(); input.blur(); }
            if (ev.key === "Escape") { ev.preventDefault(); render(); }
          });
          input.addEventListener("click", (ev) => ev.stopPropagation());
        }
        row.addEventListener("dblclick", startEdit);

        const rm = document.createElement("button");
        rm.className = "item-remove";
        rm.textContent = "×";
        rm.setAttribute("aria-label", "刪除項目");
        rm.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (clickTimer) { clearTimeout(clickTimer); clickTimer = null; }
          if (isCustomItem) {
            customItems[group.cat] = (customItems[group.cat] || []).filter(i => i !== item);
          } else if (!removedDefaults.includes(key)) {
            removedDefaults.push(key);
          }
          delete state[key];
          delete itemOverrides[key];
          saveCustom(); saveState(); saveOverrides(); saveRemoved();
          render(); updateProgress();
        });
        row.appendChild(rm);
        grid.appendChild(row);
      });
      section.appendChild(grid);
    }

    const addRow = document.createElement("div");
    addRow.className = "add-row";
    const input = document.createElement("input");
    input.type = "text";
    input.placeholder = "新增項目";
    const addBtn = document.createElement("button");
    addBtn.textContent = "＋";
    const errorEl = document.createElement("div");
    errorEl.className = "error-text";

    function submitAdd() {
      const val = input.value.trim();
      if (!val) {
        errorEl.textContent = "請輸入項目名稱";
        errorEl.style.display = "block";
        return;
      }
      if (group.items.includes(val)) {
        errorEl.textContent = "已有相同項目";
        errorEl.style.display = "block";
        return;
      }
      errorEl.style.display = "none";
      customItems[group.cat] = customItems[group.cat] || [];
      customItems[group.cat].push(val);
      saveCustom();
      render();
      updateProgress();
    }

    addBtn.addEventListener("click", submitAdd);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") { e.preventDefault(); submitAdd(); }
      else if (errorEl.style.display === "block") { errorEl.style.display = "none"; }
    });

    addRow.appendChild(input);
    addRow.appendChild(addBtn);
    section.appendChild(addRow);
    section.appendChild(errorEl);

    container.appendChild(section);
  });
}

document.getElementById("reset-btn").addEventListener("click", () => {
  state = {};
  saveState();
  render();
  updateProgress();
});

const newCatInput = document.getElementById("new-cat-input");
const newCatBtn = document.getElementById("new-cat-btn");
const newCatError = document.getElementById("new-cat-error");

function submitNewCat() {
  const val = newCatInput.value.trim();
  if (!val) {
    newCatError.textContent = "請輸入分類名稱";
    newCatError.style.display = "block";
    return;
  }
  if (DEFAULT_CAT_NAMES.includes(val) || customCategories.includes(val)) {
    newCatError.textContent = "已有相同分類";
    newCatError.style.display = "block";
    return;
  }
  newCatError.style.display = "none";
  customCategories.push(val);
  newCatInput.value = "";
  saveCustomCats();
  render();
  updateProgress();
}

newCatBtn.addEventListener("click", submitNewCat);
newCatInput.addEventListener("keydown", (e) => {
  if (e.key === "Enter") { e.preventDefault(); submitNewCat(); }
  else if (newCatError.style.display === "block") { newCatError.style.display = "none"; }
});

render();
updateProgress();
</script>
</body>
</html>
